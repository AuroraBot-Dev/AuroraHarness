{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "src/agent": {
      "release-type": "python",
      "package-name": "aurora-agent",
      "changelog-path": "CHANGELOG.md"
    },
    "src/cli": {
      "release-type": "python",
      "package-name": "aurora-cli",
      "changelog-path": "CHANGELOG.md"
    },
    "src/frontend": {
      "release-type": "node",
      "package-name": "aurora-frontend",
      "changelog-path": "CHANGELOG.md"
    },
    "src/tauri": {
      "release-type": "rust",
      "package-name": "aurora-desktop",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "tauri.conf.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
